# RenalCare Flask Application Environment Variables
# Copy this file to .env for local overrides (never commit .env to version control)

FLASK_ENV=production
FLASK_DEBUG=0
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Database Configuration:
# Leave blank for default local SQLite (renalcare.db)
# Or provide PostgreSQL URI for persistent deployment: postgresql://user:password@host:port/dbname
DATABASE_URL=

# Transactional Email Report Delivery (Resend)
# Leave RESEND_API_KEY empty to run safely with email delivery disabled
RESEND_API_KEY=
MAIL_FROM=RenalCare <onboarding@resend.dev>
APP_BASE_URL=https://ckd-screening-system.onrender.com
EMAIL_REPORT_ENABLED=true
DOWNLOAD_TOKEN_EXPIRY_HOURS=24
